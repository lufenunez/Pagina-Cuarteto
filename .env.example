# Copia este archivo como .env.local y completa los valores.

# Base de datos. En local basta con un archivo; en producción, la URL de Turso (libsql://...).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Contraseña compartida del cuarteto para entrar a /admin.
ADMIN_PASSWORD=cambia-esto

# Texto largo y aleatorio para firmar la sesión (ej: openssl rand -base64 32).
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Clave que usa Vercel para llamar a la sincronización diaria con Fever (texto largo y aleatorio).
CRON_SECRET=cambia-esto-por-otro-texto-largo-y-aleatorio

# Dirección secreta del área interna (sin "/"). Ej: con "camerino-x7k2" se entra por antiguasvanguardias.cl/camerino-x7k2
# Si no se define, queda en /admin.
ADMIN_PATH=
